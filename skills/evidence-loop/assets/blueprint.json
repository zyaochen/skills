{
  "meta": {
    "title": "订单导出服务 · 目标蓝图"
  },
  "nodes": [
    {
      "id": "api",
      "label": "导出接口",
      "sublabel": "POST /exports",
      "kind": "flow",
      "accept": "python3 -m pytest -q tests/export/test_api.py"
    },
    {
      "id": "queue",
      "label": "任务队列",
      "sublabel": "持久化、可重试",
      "kind": "external"
    },
    {
      "id": "worker",
      "label": "导出工作者",
      "sublabel": "分页读取、流式写出",
      "kind": "service",
      "accept": "python3 -m pytest -q tests/export/test_worker.py"
    },
    {
      "id": "store",
      "label": "订单仓储",
      "sublabel": "只读副本",
      "kind": "store"
    },
    {
      "id": "files",
      "label": "文件存储",
      "sublabel": "带过期时间的下载链接",
      "kind": "store"
    },
    {
      "id": "notify",
      "label": "完成通知",
      "kind": "service"
    }
  ],
  "edges": [
    {
      "from": "api",
      "to": "queue",
      "label": "入队"
    },
    {
      "from": "queue",
      "to": "worker",
      "label": "消费"
    },
    {
      "from": "worker",
      "to": "store",
      "label": "读取"
    },
    {
      "from": "worker",
      "to": "files",
      "label": "写出"
    },
    {
      "from": "worker",
      "to": "notify",
      "label": "完成"
    }
  ],
  "regions": [
    {
      "label": "异步链路",
      "wraps": [
        "queue",
        "worker",
        "notify"
      ]
    }
  ],
  "depends": {
    "api": [
      "queue"
    ],
    "worker": [
      "queue",
      "store",
      "files"
    ],
    "notify": [
      "worker"
    ]
  }
}
